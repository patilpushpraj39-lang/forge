FORGE_DATABASE_PATH=.state/forge.db
# PostgreSQL takes precedence when this is set.
# FORGE_DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
FORGE_MIGRATIONS_PATH=db/migrations
FORGE_ARTIFACT_PATH=.state/artifacts
# FORGE_ARTIFACT_BACKEND=s3
# FORGE_ARTIFACT_BUCKET=forge-artifacts
# FORGE_ARTIFACT_PREFIX=forge/artifacts
# FORGE_ARTIFACT_ENDPOINT_URL=http://localhost:9000
# FORGE_ARTIFACT_REGION=us-east-1
# Use "docker" only with an immutable digest in FORGE_SANDBOX_IMAGE.
FORGE_SANDBOX_BACKEND=local
# FORGE_SANDBOX_IMAGE=python@sha256:<64 lowercase hexadecimal characters>
FORGE_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FORGE_API_URL=http://localhost:8000
# Approval and publication fail closed while this remains disabled.
FORGE_AUTH_MODE=disabled
# To enable Clerk, set FORGE_AUTH_MODE=clerk and configure every value below.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example
# CLERK_SECRET_KEY=sk_test_example
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# FORGE_REVIEWER_IDS=user_example
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Configure both values to enable server-side GitHub installation discovery and
# immutable repository ingestion. Never expose the private key to the web app.
# FORGE_GITHUB_APP_CLIENT_ID=Iv1.example
# FORGE_GITHUB_APP_PRIVATE_KEY_PATH=C:/secure/forge-app.private-key.pem
