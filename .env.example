FORGE_DATABASE_PATH=.state/forge.db
# PostgreSQL takes precedence when this is set.
# FORGE_DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
FORGE_MIGRATIONS_PATH=db/migrations
FORGE_ARTIFACT_PATH=.state/artifacts
# Use "docker" only with an immutable digest in FORGE_SANDBOX_IMAGE.
FORGE_SANDBOX_BACKEND=local
# FORGE_SANDBOX_IMAGE=python@sha256:<64 lowercase hexadecimal characters>
FORGE_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FORGE_API_URL=http://localhost:8000
