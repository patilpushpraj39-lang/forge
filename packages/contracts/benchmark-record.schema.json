{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/benchmark-record.schema.json",
  "title": "Forge benchmark result record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_version",
    "experiment_id",
    "configuration_digest",
    "code_revision",
    "task_id",
    "task_version",
    "task_split",
    "category",
    "language",
    "run_id",
    "task_manifest_digest",
    "evaluation_manifest_digest",
    "verdict",
    "failure_code",
    "regression_free",
    "patch_attempts",
    "duration_ms",
    "cost_microusd",
    "tool_calls"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "experiment_id": {
      "$ref": "#/$defs/identifier"
    },
    "configuration_digest": {
      "$ref": "#/$defs/sha256"
    },
    "code_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_split": {
      "enum": ["development", "holdout", "public"]
    },
    "category": {
      "enum": ["frontend", "backend", "api", "data", "test"]
    },
    "language": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evaluation_manifest_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "verdict": {
      "enum": [
        "solved",
        "unsolved",
        "budget_exhausted",
        "policy_violation",
        "infra_invalid",
        "task_invalid"
      ]
    },
    "failure_code": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "regression_free": {
      "type": "boolean"
    },
    "patch_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cost_microusd": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "solved"
          }
        }
      },
      "then": {
        "properties": {
          "failure_code": {
            "type": "null"
          },
          "regression_free": {
            "const": true
          },
          "evaluation_manifest_digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "else": {
        "properties": {
          "failure_code": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
