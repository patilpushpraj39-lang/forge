{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/run-event.schema.json",
  "title": "Forge Run Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "schema_version",
    "event_type",
    "occurred_at",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "schema_version": { "const": 1 },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "string",
      "enum": ["user", "api", "worker", "model", "sandbox", "evaluator", "publisher"]
    },
    "payload": { "type": "object" }
  }
}

